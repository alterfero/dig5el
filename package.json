{
  "name": "dig4el",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit --incremental false",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:smoke": "npm run build && node --test tests/smoke/*.test.mjs",
    "check": "npm run typecheck && npm run lint && npm run test && npm run test:smoke",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:migrate": "node --env-file-if-exists=.env.local scripts/migrate.mjs",
    "admin:bootstrap": "node --env-file-if-exists=.env.local scripts/bootstrap-system-admin.mjs"
  },
  "dependencies": {
    "next": "16.2.6",
    "pg": "8.18.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "read-excel-file": "9.3.10"
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "@next/eslint-plugin-next": "16.2.6",
    "@tailwindcss/postcss": "4.2.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "22.19.19",
    "@types/pg": "8.15.6",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.4",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.4.0",
    "jsdom": "29.0.1",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.3",
    "vite": "8.0.13",
    "vitest": "5.0.1"
  },
  "type": "module"
}
