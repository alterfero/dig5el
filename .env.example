# Server-only runtime configuration. Never prefix PLAID secrets with NEXT_PUBLIC_ or VITE_.
DIG4EL_ENVIRONMENT=development
DIG4EL_LOG_LEVEL=info
DIG4EL_APP_ORIGIN=http://localhost:3000

# PLAID authentication remains intentionally disabled until the ADR decision is approved.
PLAID_AUTH_MODE=disabled
PLAID_BASE_URL=

# Set real values only in ignored local/runtime secret storage.
SESSION_ENCRYPTION_KEY=
PLAID_SERVICE_TOKEN=
