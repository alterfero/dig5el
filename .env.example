# Server-only runtime configuration. Never prefix secrets with NEXT_PUBLIC_ or VITE_.
DIG4EL_ENVIRONMENT=development
DIG4EL_LOG_LEVEL=info
DIG4EL_APP_ORIGIN=http://localhost:3000
DIG4EL_TRUST_PROXY=false
# Optional for a visual-only LAN preview in `next dev`: hostnames only, with
# no scheme or port. Keep authenticated testing on localhost unless HTTPS is
# configured for the other device/origin.
DIG4EL_ALLOWED_DEV_ORIGINS=

# Local DIG4EL accounts are separate from PLAID. Keep disabled until PostgreSQL
# is configured; use local-password for administrator-issued setup tokens.
DIG4EL_AUTH_MODE=disabled
DATABASE_URL=
# Generate a 32-byte value, for example:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
SESSION_ENCRYPTION_KEY=
AUTH_SESSION_TTL_SECONDS=28800

# File imports need no PLAID connection. Keep disabled and leave credentials
# unset; direct API integration is outside the current scope (ADR 0002).
PLAID_AUTH_MODE=disabled
PLAID_BASE_URL=
PLAID_SERVICE_TOKEN=
